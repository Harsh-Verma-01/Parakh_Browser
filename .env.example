# Parakh_Browser Environment Configuration

# Application
NODE_ENV=production
PORT=8000

# AWS Infrastructure
AWS_REGION=us-east-1
COLLECTION_ID=parakh-biometric-collection
FACES_TABLENAME=ParakhCandidateFaces
EVIDENCE_BUCKET=parakh-proctoring-evidence
MIN_CONFIDENCE=80.0

# Proctoring Settings
OBJECTS_OF_INTEREST_LABELS=Cell Phone,Mobile Phone,Phone,Electronics,Headphones,Book
YAW_THRESHOLD=12.0
PITCH_THRESHOLD=12.0

# Optional Persistence Integration (REST / DynamoDB / Realtime DB)
DATABASE_BACKEND_URL=https://your-parakh-assessment-db.example.com
DATABASE_API_KEY=your-secure-api-key
